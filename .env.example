# Copy to .env and edit.

# Local Docker (see docker-compose.yml):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_api
# Supabase: Project Settings -> Database -> Connection string (URI). Use the
# "Session pooler" or direct connection string; append ?sslmode=require.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional. When set, clients must send header `X-API-Key: <value>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# File watcher (python -m app.watcher). Folders to index: source name -> path, as JSON.
# Use forward slashes; keep the single quotes. Add more sources later, e.g. "project:api".
WATCH_SOURCES='{"vault": "C:/Users/you/Obsidian Vault"}'
# Local Ollama with the embedding model pulled (ollama pull nomic-embed-text).
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Top-level folder of retired notes in each source: never indexed, and items go to the Recycle
# Bin after this many days in it (0 = keep it out of search but never clear it).
ARCHIVE_FOLDER=OUTDATED
ARCHIVE_RETENTION_DAYS=30

# Only used by the test suite. MUST be a throwaway database (tables get truncated).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_api_test
